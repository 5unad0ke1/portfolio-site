---
import Layout from '../../Layouts/BaseLayout.astro';
import {getAllWorks} from '../../js/works.js'

export async function getStaticPaths() {
    const works = getAllWorks();

    return works.map(work => ({
        params: { id: work.id },   
        props: { work },           
    }));
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL;
---



<Layout>
    <div class="padding">

        <!-- Header -->
        <div class="test-card">

            <!-- name -->
            <div class="content-h1">
                {work.name}
            </div>

            <!-- meta -->
            <div class="meta-section">
                <h3 class="section-label">プロジェクト情報</h3>
                <div class="meta white">
                    <span class="meta-data">{work.about}</span>
                    <span class="meta-data">{work.role}</span>
                    <span class="meta-data">{work.status}</span>
                </div>
            </div>

            <!-- technologies -->
            <div class="tech-section">
                <h3 class="section-label">使用技術</h3>
                <div class="languages">
                    {work.languages.map(language => (
                    <span class="language-data">
                        {language}
                    </span>
                    ))}
                </div>
            </div>
            <hr>
            <!-- header image -->
            <img class="header-image" src={`${base}${work.image.slice(1)}`} alt={work.name} />
        </div>
        
        <!-- description -->
        <div class="test-card white">
            {work.description}
        </div>

        <!-- Links -->
        
        <div class="test-card">
            <div class="content-h1">
                [Related Links]
            </div>

            {work.links && work.links.length > 0 ? (
            <div class="links">
                {work.links.map(link => (
                    <a target="_blank" rel="noopener noreferrer" href={link.link}>
                        {link.name}
                    </a>
                ))}
            </div>
            ) : (
            <div class="white">
                リンクなし
            </div>
            )}
        </div>
    </div>
</Layout>

<style>
    .padding{
        max-width: 1000px;
        margin: 0 auto;
    }
    .white {
        color: rgb(var(--font));
        white-space: pre-line;
    }
    
    .section-label {
        color: rgb(var(--h1-color));
        font-size: 16px;
        font-weight: bold;
        margin: 24px 0 12px 0;
    }

    .meta-section,
    .tech-section {
        margin-bottom: 20px;
    }

    .meta{
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .meta .meta-data{
        background-color: rgba(var(--h1-color), 0.15);
        border: 1px solid rgba(var(--h1-color), 0.3);
        border-radius: 10px;
        padding: 8px 12px;
        font-size: 14px;
    }
    .header-image{
        width: 100%;
        max-width: 1000px;
        max-height: 500px;
        object-fit: contain;
    }
    a{
        color: rgb(var(--h1-color));
    }
    .languages{
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        color: rgb(var(--font));
    }
    .languages .language-data{
        background-color: rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 5px;
    }
    .links{
        display:flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .links a{
        background-color: rgba(255,255,255,0.1);
        border-radius: 10px;
        padding: 10px;
    }
</style>

