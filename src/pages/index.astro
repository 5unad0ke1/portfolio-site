---
import Header from '../components/Header.astro';
import SNS from '../components/SNS.astro';
import FirstView from '../components/FirstView.astro';
import MainContents from '../components/MainContents.astro';
import Footer from '../components/Footer.astro';

import Script from '../components/Script.astro';
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <meta name="description" content="砂時計工房の砂時計のポートフォリオ">
    <meta property="og:title" content="砂時計工房の砂時計">
    <meta property="og:description" content="砂時計工房の砂時計のポートフォリオ">
    <meta property="og:image" content={`${import.meta.env.BASE_URL}images/5unad0ke1.jpg`}>
    
    <!-- cssリセットファイル -->
    <link rel="preload" href="https://unpkg.com/ress@4.0.0/dist/ress.min.css" as="style" onload="this.rel='stylesheet'">
    <noscript>
    <link rel="stylesheet" href="https://unpkg.com/ress@4.0.0/dist/ress.min.css">
    </noscript>
    
    <!-- アイコン画像のdevicon -->
    <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" media="print" onload="this.media='all'"/>      
    <noscript>
        <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
    </noscript>      

    <!-- フォントのFiraCode -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;700&display=swap" as="style" onload="this.rel='stylesheet'">
    <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;700&display=swap">
    </noscript>
    
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/layout.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/styles.css`}>

    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/animation.css`}>

    <link rel="icon" href={`${import.meta.env.BASE_URL}images/5unad0ke1.jpg`}>

    <title>砂時計工房の砂時計</title>
</head>

<body>
    <Header />
    <SNS />

    <FirstView />
    <MainContents />

    <Footer />
    
    <Script />
</body>