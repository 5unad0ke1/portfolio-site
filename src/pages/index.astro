---
import Header from '../components/Header.astro';
import Works from '../components/Works.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <meta name="description" content="砂時計のポートフォリオサイトです。ゲームクライアントエンジニア志望。Unityを用いたゲーム開発のスキルや作品を紹介しています。">
    
    <!-- cssリセットファイル -->
    <link rel="preload" href="https://unpkg.com/ress@4.0.0/dist/ress.min.css" as="style" onload="this.rel='stylesheet'">
    <noscript>
    <link rel="stylesheet" href="https://unpkg.com/ress@4.0.0/dist/ress.min.css">
    </noscript>
    
    <!-- アイコン画像のdevicon -->
    <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" media="print" onload="this.media='all'"/>      
    <noscript>
        <link rel="stylesheet" type='text/css' href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css">
    </noscript>      

    <!-- フォントのFiraCode -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;700&display=swap" as="style" onload="this.rel='stylesheet'">
    <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;700&display=swap">
    </noscript>
    
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/layout.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/styles.css`}>

    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/animation.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/header.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/works.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/about-me.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/skills.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/fixed.css`}>
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}css/contact.css`}>

    <link rel="icon" href={`${import.meta.env.BASE_URL}images/5unad0ke1.jpg`}>

    <title>砂時計</title>
</head>

<body>

    <div class="fixed-sns">
        <a target="_blank" rel="noopener noreferrer" href="https://x.com/5unad0ke1">
            <div>
                <svg class="icon icon-40" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <title>X</title>
                    <path fill="white" d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
                </svg>
            </div>
        </a>
        <a target="_blank" rel="noopener noreferrer" href="https://github.com/5unad0ke1">
            <div>
                <svg class="icon icon-40" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <title>GitHub</title>
                    <path fill="white" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
            </div>
        </a>
        <a target="_blank" rel="noopener noreferrer" href="https://zenn.dev/5unad0ke1">
            <div>
                <svg class="icon icon-40" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <title>Zenn</title>
                    <path fill="white" d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41zM17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234-.001.468-.118.586-.353z"/>
                </svg>
            </div>
        </a>
    </div>

    <div class="fixed">
        <a href="#works">
            - works
        </a>
        <a href="#about-me">
            - about me
        </a>
        <a href="#skills">
            - skills
        </a>
        <a href="#contact">
            - contact
        </a>
    </div>

    <Header />

    <main class="main-content">

        <Works />

        <div class="padding-side">
            <hr>
        </div>

        <About />

        <div class="padding-side">
            <hr>
        </div>

        <Skills />

        <div class="padding-side">
            <hr>
        </div>

        <Contact />

        <div class="padding-side">
            <hr>
        </div>
    </main>

    <Footer />

    <script src="../js/main.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6Z6GXDMF6E"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-6Z6GXDMF6E');
    </script>
</body>