
---
import profile from '../data/profile.yaml';

const socialIcons = {
    X: `<svg class="icon" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <title>X</title>
        <path fill="currentColor" d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
    </svg>`,
    GitHub: `<svg class="icon" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <title>GitHub</title>
        <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
    </svg>`,
    Zenn: `<svg class="icon" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <title>Zenn</title>
        <path fill="currentColor" d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.176-.293-.029-.645-.381-.645h-4.72c-.235 0-.44.117-.557.323L.03 23.361c-.088.176.029.41.234.41zM17.445 23.419l6.479-10.408c.205-.323-.029-.733-.41-.733h-4.691c-.176 0-.352.088-.44.235l-6.655 10.643c-.176.264.029.616.352.616h4.779c.234-.001.468-.118.586-.353z"/>
    </svg>`,
};
---

<div class="fixed">
    <button class="hamburger" aria-label="メニューを開く" aria-expanded="false">
        ☰
    </button>

    <div class="nav">
        <a href="#works">
            - works
        </a>
        <a href="#track-record">
            - track record
        </a>
        <a href="#about-me">
            - about me
        </a>
        <a href="#skills">
            - skills
        </a>
        <a href="#contact">
            - contact
        </a>
        <div class="nav-sns">
            {profile.social.map(link => (
                <a target="_blank" rel="noopener noreferrer" href={link.url} title={link.title} class="sns-link">
                    <Fragment set:html={socialIcons[link.title]} />
                </a>
            ))}
        </div>
    </div>
</div>


<style>
    .fixed{
        color: white;
        position: fixed;
        top: 0px;
        width: 100%;
        z-index: 1;
        background-color: rgba(0,0,0, 0.2);

        height: auto;
        min-height: 60px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        padding: 8px 20px;

    }
    @media (max-width: 768px)  {
        .fixed{
            height: 70px;
            display: block;
        }
        .fixed.show{
            height: auto;
            background-color: rgba(0,0,0, 0.6);
        }
    }

    .nav{
        display: flex;
        
        flex-direction: row;
        justify-content: center;
        align-items: center;

    }
    @media (max-width: 768px)  {
        .nav{
            display: none;
            flex-direction: column;
        }
        .nav.show{
            display: flex;
        }
    }

    .hamburger{
        opacity: 0;
        display: none;
        margin: 12px;
    }
    @media (max-width: 768px)  {
        .hamburger{
            opacity: 1;
            display: block;

            font-size: clamp(2rem, 4vw, 4rem);
            color: white;
        }
    }

    .fixed a{
        font-size: clamp(0.7rem, 4vw, 1rem);
        color: white;
        text-decoration: none;
        user-select: none;
        margin: 10px;
    }
    @media (hover: hover) and (pointer: fine) {
        .fixed a:hover{
            text-decoration: underline;

            filter: drop-shadow(0 0 10px white);
        }
    }

    .nav-sns {
        display: flex;
        gap: 8px;
        margin-left: 15px;
        align-items: center;
        flex-wrap: nowrap;
    }

    @media (max-width: 768px) {
        .nav-sns {
            gap: 15px;
            margin-left: 0;
            margin-top: 15px;
            padding: 15px 0;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
            justify-content: center;
            width: 100%;
        }
    }

    .sns-link {
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        margin: 0 !important;
        padding: 4px;
    }

    .sns-link{
        width: 32px;
        height: 32px;
    }

    @media (max-width: 768px) {
        .sns-link {
            width: 40px;
            height: 40px;
        }
    }

    @media (hover: hover) and (pointer: fine) {
        .sns-link:hover {
            transform: scale(1.15);
        }
    }
</style>

<script is:inline>
    const fixed = document.querySelector('.fixed');
    const hamburger = document.querySelector('.hamburger');
    const links = document.querySelectorAll('.nav');

if(fixed && hamburger){       
    hamburger.addEventListener('click', () => {
        const isExpanded = hamburger.getAttribute('aria-expanded') === 'true';
        hamburger.setAttribute('aria-expanded', String(!isExpanded));
        hamburger.setAttribute('aria-label', isExpanded ? 'メニューを開く' : 'メニューを閉じる');
        fixed.classList.toggle('show');
        links.forEach(link => {
            link.classList.toggle('show');
        });
    });
}
</script>