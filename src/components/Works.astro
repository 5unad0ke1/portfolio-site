---
import { IconMap } from '../../public/ts/iconHTML';
import works from '../data/works.yaml';
---

<!-- ===== Works ===== -->
<section class="works padding-side padding-bottom" id="works"> 
    <div class="content-h1 animate-on-scroll">
        [Works]
    </div>
    
    
    {works.map(work => (
    <div class="left2right works-content animate-on-scroll show" id={work.id}>
            <div class="h1">
                <div>
                    <div class="main">
                        {work.name}
                    </div>
                    <div class="about">
                        {work.about}
                    </div>
                </div>
                <div class="image font-32">
                    {work.languages.map(icon => <i class={IconMap[icon]}></i>)}
                </div>
            </div>
            <div class="detail">
                <br>
                {work.description}
            </div>
    </div>
    ))}
</section>