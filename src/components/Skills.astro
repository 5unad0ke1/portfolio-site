---
import { IconMap } from '../utils/iconHTML';
import skills from '../data/skills.yaml';
---

<section class="skills padding-side" id="skills">
    <div class="test-card">
        <div class="content-h1">
            <div class="animate-on-scroll">
                [Skills]
            </div>

            <div class="test">
                {Object.values(IconMap).map(icon => <i class={icon}></i>)}
            </div>
        </div>
        
        <div class="skills-contents">
            
        {skills.map(skill => (
        <div>{skill.category}</div>

        <div class="skills-group">
            {skill.items.map(s => (

            <a class="skill" href={`#${s.jumpto}`}>
                <div class="h1">{s.h1}</div>
                <div class="h2">{s.h2}</div>
                <div class="icons">
                
                {s.icons.map(icon => (
                    <i class={IconMap[icon]}></i>
                ))}

                </div>
            </a>
            ))}
        </div>
    ))}
        </div>
    </div>
</section>




<style>
    .skills .test{
        color: rgb(var(--h1-color));
        opacity: 0.5;
        display: flex;
        gap: 4px;
        font-size: clamp(0.5rem, 2.9vw, 1rem);
        margin: 0 10px;
    }

    .skills .skills-group{
        flex-wrap: wrap;
        justify-content: center;

        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, max-content));



        gap: 30px;
    }


    .skills .skills-contents{
        margin-bottom: 1dvh;
        padding: 0;
        color: rgb(var(--font));
        text-align: center;
        font-size: var(--32);
    }

    .skills .skill{
        position: relative;
        display: flex;
        flex-direction: column;
        height: 280px;
        width: 350px;

        padding: 24px;

        text-decoration: none;
        background: linear-gradient(135deg, rgba(var(--h1-color), 0.15) 0%, rgba(var(--h1-color), 0.08) 100%);
        border: 2px solid rgba(var(--h1-color), 0.3);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);

        border-radius: 12px;
        
        text-align: center;
        font-size: var(--16);
        white-space: pre-line;
        transition: all 0.3s ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .skills .skill:hover{
            transform: translateY(-8px);
            border-color: rgb(var(--h1-color));
            box-shadow: 0 8px 25px rgba(var(--h1-color), 0.2);
            transition: all 0.3s ease;
        }
    }

    .skills .skill .h1{
        font-size: 24px;
        font-weight: bold;
        color: rgb(var(--h1-color));
        margin-bottom: 12px;
        margin-top: 0;
        order: 2;
    }

    .skills .skill .h2{
        font-size: 14px;
        color: rgba(255, 255, 255, 0.7);
        margin: 0 0 20px 0;
        order: 3;
    }

    .skills .skill .icons{
        color: rgb(var(--h1-color));
        opacity: 0.8;

        font-size: 48px;
        display: flex;
        gap: 12px;
        justify-content: center;
        align-items: center;

        margin-bottom: 16px;
        order: 1;
        flex-wrap: wrap;
    }
</style>