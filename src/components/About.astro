---
import profile from '../data/profile.yaml';
---


<section class="about-me padding-side" id="about-me">
<div class="test-card">

    <div class="content-h1 animate-on-scroll">
        [AboutMe]
    </div>

    <div class="animate-on-scroll left2right">
        <div class="cardTop">
            <img src={`${import.meta.env.BASE_URL}images/5unad0ke1.jpg`} alt="アイコン" width="200" height="200">
        </div>
        <div class="cardDown">
            <div>{profile.description}</div>
            <hr>

            {profile.items.map(item => (
                <div class="row">
                    <span class="key">{item.key}:</span>
                    <span>{item.value}</span>
                </div>
            ))}
        </div>
    </div>
</div>
</section>

<style>
    .row .key{
        color: rgb(var(--h1-color));
    }
    .about-me .row{
        display: grid;
        grid-template-columns: 140px 1fr;
        font-size: var(--16);
        padding: 5px 0 5px 0;
    }
    .about-me .cardTop{
        background-color: #111;
        padding: 20px;
        border-radius: 20px 20px 0 0;
    }
    .about-me .cardDown{
        background-color: #333;
        padding: 20px;
        border-radius: 0 0 20px 20px;
        white-space: pre-line;
    }

    .about-me{
        color: rgb(var(--font));
        font-size: var(--16);

        letter-spacing: 0.1em;
    }

    .about-me img{
        border-radius: 50%;
    }
</style>