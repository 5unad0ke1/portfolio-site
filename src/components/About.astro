---
import profile from '../data/profile.yaml';
---


<section class="about-me padding-side" id="about-me">
<div class="test-card">

    <div class="content-h1 animate-on-scroll">
        [AboutMe]
    </div>

    <div class="animate-on-scroll left2right">
        <div class="profile-card">
            <div class="profile-header">
                <img src={`${import.meta.env.BASE_URL}images/5unad0ke1.jpg`} alt="アイコン" width="200" height="200" class="profile-image">
                <div class="profile-name-section">
                    <h2 class="profile-name">{profile.items.find(item => item.key === 'name').value}</h2>
                    <p class="profile-role">{profile.items.find(item => item.key === 'role').value}</p>
                </div>
            </div>
            <div class="profile-content">
                <div class="profile-description">{profile.description}</div>
                <hr>

                {profile.items.map(item => (
                    item.key !== 'name' && item.key !== 'role' && (
                        <div class="row">
                            <span class="key">{item.key}:</span>
                            <span>{item.value}</span>
                        </div>
                    )
                ))}
            </div>
        </div>
    </div>
</div>
</section>

<style>
    .profile-card {
        background: linear-gradient(135deg, rgba(100, 100, 150, 0.1) 0%, rgba(80, 80, 120, 0.05) 100%);
        border-radius: 20px;
        padding: 0;
        overflow: hidden;
        border: 1px solid rgba(100, 150, 200, 0.2);
    }

    .profile-header {
        display: flex;
        align-items: center;
        gap: 30px;
        padding: 30px;
        background: linear-gradient(135deg, rgba(100, 120, 150, 0.15) 0%, rgba(60, 80, 110, 0.1) 100%);
        border-bottom: 1px solid rgba(100, 150, 200, 0.15);
    }

    .profile-image {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }

    .profile-name-section {
        flex: 1;
    }

    .profile-name {
        margin: 0 0 10px 0;
        font-size: clamp(1.5rem, 5vw, 2.2rem);
        font-weight: 700;
        color: rgb(var(--h1-color));
        letter-spacing: 0.05em;
    }

    .profile-role {
        margin: 0;
        font-size: clamp(0.9rem, 2.5vw, 1.1rem);
        color: rgba(var(--h1-color), 0.8);
        font-weight: 500;
        opacity: 0.9;
    }

    .profile-content {
        padding: 30px;
    }

    .profile-description {
        margin-bottom: 20px;
        line-height: 1.8;
        white-space: pre-line;
    }

    .row .key {
        color: rgb(var(--h1-color));
        font-weight: 600;
    }

    .about-me .row {
        display: grid;
        grid-template-columns: 140px 1fr;
        font-size: var(--16);
        padding: 8px 0;
    }

    .about-me {
        color: rgb(var(--font));
        font-size: var(--16);
        letter-spacing: 0.1em;
    }

    @media (max-width: 600px) {
        .profile-header {
            flex-direction: column;
            text-align: center;
            gap: 15px;
            padding: 20px;
        }

        .profile-image {
            width: 120px;
            height: 120px;
        }

        .profile-name {
            font-size: 1.5rem;
        }

        .about-me .row {
            grid-template-columns: 100px 1fr;
        }
    }
</style>